{
  "expo": {
    "name": "bdg",
    "slug": "bdg",
    "version": "1.0.24",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./res/img/logo.png",
    "splash": {
      "image": "./res/img/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "url": "https://u.expo.dev/9b162888-deed-4315-950d-c955c92b54cb"
    },
    "runtimeVersion": "1.0.24",
    "ios": {
      "bundleIdentifier": "com.bdgguard",
      "buildNumber": "24",
      "supportsTablet": true
    },
    "android": {
      "package": "com.bdgguard",
      "versionCode": 24,
      "adaptiveIcon": {
        "foregroundImage": "./res/img/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "experiments": {
      "newArchEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "9b162888-deed-4315-950d-c955c92b54cb"
      }
    }
  }
}
