{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.17.0"
    },
    "preview": {
      "distribution": "internal",
      "node": "20.17.0",
      "ios": {
        "cache": {
          "disabled": true
        }
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "20.17.0",
      "ios": {
        "buildConfiguration": "Release",
        "cache": {
          "disabled": false
        }
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6756548993"
      }
    }
  }
}
